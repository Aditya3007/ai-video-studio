# AI Video Studio Environment Variables
# Copy this file to .env and fill in the actual values for your local environment.
# Never commit .env or any file containing real credentials.

# Application configuration (used by the current application)
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Database (to be configured in P1; ignored until implemented)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_video_studio

# Redis (to be configured in P12; ignored until implemented)
REDIS_URL=redis://localhost:6379

# Object storage
STORAGE_BACKEND=filesystem
STORAGE_LOCAL_ROOT=storage
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_BUCKET=ai-video-studio

# AI provider API keys (to be configured in P11; ignored until implemented)
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# LLM provider selection (P3-T03: deterministic, fake, openai, anthropic, gemini, local)
LLM_PROVIDER=deterministic
LLM_MODEL=

# YouTube OAuth credentials (to be configured in P13; ignored until implemented)
YOUTUBE_CLIENT_ID=your_youtube_client_id
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token
