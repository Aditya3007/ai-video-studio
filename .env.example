# AI Video Studio Environment Variables
# Copy this file to .env and fill in the actual values

# Backend
BACKEND_HOST=localhost
BACKEND_PORT=8000

# Database (to be configured in P1)
DATABASE_URL=postgresql://user:password@localhost:5432/ai_video_studio

# Redis (to be configured in P12)
REDIS_URL=redis://localhost:6379

# AI Provider API Keys (to be configured in P11)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Storage (to be configured in P1)
STORAGE_TYPE=local
STORAGE_PATH=./storage

# YouTube (to be configured in P13)
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
